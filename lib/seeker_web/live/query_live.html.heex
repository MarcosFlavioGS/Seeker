<div class="p-4 space-y-4">
  <%!-- Org header + environment tabs --%>
  <div class="flex flex-wrap items-center gap-4">
    <.link navigate={~p"/"} class="btn btn-ghost btn-sm gap-1 -ml-2">
      <.icon name="hero-chevron-left" class="size-4" /> Organizations
    </.link>

    <h1 class="text-xl font-bold">{@org_info.display}</h1>

    <div role="tablist" class="tabs tabs-bordered">
      <%= for {env_key, env_data} <- @org_info.environments do %>
        <.link
          navigate={~p"/orgs/#{@org}/#{env_key}"}
          role="tab"
          class={["tab gap-2", if(@env == env_key, do: "tab-active font-semibold", else: "")]}
        >
          {env_data.display}
          <span class={["badge badge-sm", badge_class(Map.get(@conn_statuses, env_key, :unknown))]}>
            {badge_text(Map.get(@conn_statuses, env_key, :unknown))}
          </span>
        </.link>
      <% end %>
    </div>
  </div>

  <%!-- Two-column layout: sidebar + editor --%>
  <div class="grid grid-cols-1 lg:grid-cols-4 gap-4 items-start">
    <%!-- Predefined queries sidebar, grouped by context --%>
    <div class="lg:col-span-1">
      <div class="card bg-base-200 shadow-sm">
        <div class="card-body p-3">
          <%!-- Sidebar header --%>
          <div class="flex items-center justify-between mb-1">
            <span class="text-xs font-semibold uppercase tracking-wider text-base-content/50 px-1">
              Queries
            </span>
            <button
              phx-click="open_new_query"
              class="btn btn-xs btn-ghost gap-1 text-primary"
              title="New query"
            >
              <.icon name="hero-plus" class="size-3.5" /> New
            </button>
          </div>

          <%= for {context, queries} <- @grouped_queries do %>
            <p class="text-xs font-semibold uppercase tracking-wider text-base-content/50 mt-3 mb-1 first:mt-0 px-1">
              {context}
            </p>
            <div class="flex flex-col gap-0.5">
              <%= for query <- queries do %>
                <div class="group flex items-center gap-0.5">
                  <button
                    phx-click="load_query"
                    phx-value-key={query.key}
                    class={[
                      "btn btn-xs btn-ghost justify-start text-left normal-case h-auto min-h-0 py-1.5 px-2 leading-snug flex-1 min-w-0",
                      if(@active_query_key == query.key, do: "btn-active", else: "")
                    ]}
                  >
                    <span class="truncate">{query.name}</span>
                  </button>
                  <button
                    phx-click="edit_query"
                    phx-value-key={query.key}
                    class="btn btn-xs btn-ghost px-1 opacity-0 group-hover:opacity-100 transition-opacity shrink-0"
                    title="Edit"
                  >
                    <.icon name="hero-pencil-square" class="size-3" />
                  </button>
                  <button
                    phx-click="delete_query"
                    phx-value-key={query.key}
                    phx-confirm={"Delete \"#{query.name}\"?"}
                    class="btn btn-xs btn-ghost px-1 opacity-0 group-hover:opacity-100 transition-opacity text-error shrink-0"
                    title="Delete"
                  >
                    <.icon name="hero-trash" class="size-3" />
                  </button>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <%!-- SQL editor + run controls --%>
    <div class="lg:col-span-3 space-y-4">
      <div class="card bg-base-200 shadow-sm">
        <div class="card-body p-4">
          <form phx-submit="run_query" id="query-form">
            <textarea
              name="sql"
              id="sql-editor"
              rows="12"
              class="textarea textarea-bordered w-full font-mono text-sm leading-relaxed"
              placeholder="SELECT * FROM your_table LIMIT 100;"
              spellcheck="false"
            ><%= @sql %></textarea>

            <div class="flex flex-wrap items-center gap-3 mt-3">
              <button type="submit" class="btn btn-primary btn-sm" disabled={@running}>
                <%= if @running do %>
                  <span class="loading loading-spinner loading-xs"></span> Running...
                <% else %>
                  Run Query
                <% end %>
              </button>

              <button
                type="button"
                phx-click="clear"
                class="btn btn-ghost btn-sm"
                disabled={@running}
              >
                Clear
              </button>

              <%= if @result do %>
                <span class="text-sm text-base-content/50 ml-auto">
                  {result_meta(@result)}
                </span>
              <% end %>
            </div>
          </form>
        </div>
      </div>

      <%!-- Results --%>
      <%= if @result do %>
        <div class="card bg-base-200 shadow-sm">
          <div class="card-body p-4">
            <%= case @result do %>
              <% {:ok, result} when result.num_rows == 0 -> %>
                <p class="text-sm text-base-content/50">Query returned no rows.</p>
              <% {:ok, result} -> %>
                <%!-- Results toolbar --%>
                <div class="flex items-center justify-between mb-3">
                  <span class="text-xs text-base-content/50">
                    {result.num_rows} {if result.num_rows == 1, do: "row", else: "rows"}
                  </span>
                  <button
                    phx-click="copy_json"
                    class="btn btn-xs btn-ghost gap-1.5"
                  >
                    <%= if @copied do %>
                      <.icon name="hero-check" class="size-3.5 text-success" />
                      <span class="text-success">Copied!</span>
                    <% else %>
                      <.icon name="hero-clipboard-document" class="size-3.5" /> Copy as JSON
                    <% end %>
                  </button>
                </div>

                <div class="overflow-x-auto max-h-[60vh] overflow-y-auto">
                  <table class="table table-xs table-zebra table-pin-rows">
                    <thead>
                      <tr>
                        <th :for={col <- result.columns} class="whitespace-nowrap">
                          {col}
                        </th>
                      </tr>
                    </thead>
                    <tbody>
                      <tr :for={row <- result.rows}>
                        <td :for={cell <- row} class="font-mono text-xs max-w-xs truncate">
                          {format_cell(cell)}
                        </td>
                      </tr>
                    </tbody>
                  </table>
                </div>
              <% {:error, {kind, msg}} -> %>
                <div class="alert alert-error items-start">
                  <.icon name="hero-exclamation-circle" class="size-5 shrink-0 mt-0.5" />
                  <div>
                    <p class="font-semibold">{error_kind_label(kind)}</p>
                    <p class="font-mono text-sm mt-1 whitespace-pre-wrap">{msg}</p>
                  </div>
                </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
</div>

<%!-- Query form modal --%>
<dialog class={["modal", if(@show_form, do: "modal-open")]}>
  <div class="modal-box max-w-2xl">
    <h3 class="font-bold text-lg mb-4">
      {if @editing_key, do: "Edit Query", else: "New Query"}
    </h3>

    <form phx-submit="save_query" class="space-y-4">
      <div class="grid grid-cols-2 gap-4">
        <div class="form-control">
          <label class="label pb-1">
            <span class="label-text font-medium">Context</span>
          </label>
          <input
            type="text"
            name="context"
            value={@form_query["context"] || ""}
            placeholder="e.g. Mobility"
            class="input input-bordered input-sm"
            required
          />
        </div>
        <div class="form-control">
          <label class="label pb-1">
            <span class="label-text font-medium">Name</span>
          </label>
          <input
            type="text"
            name="name"
            value={@form_query["name"] || ""}
            placeholder="e.g. Find Order by Email"
            class="input input-bordered input-sm"
            required
          />
        </div>
      </div>

      <div class="form-control">
        <label class="label pb-1">
          <span class="label-text font-medium">SQL</span>
        </label>
        <textarea
          name="sql"
          rows="12"
          class="textarea textarea-bordered font-mono text-sm leading-relaxed w-full"
          placeholder="SELECT * FROM your_table WHERE id = :id;"
          spellcheck="false"
          required
        ><%= @form_query["sql"] || "" %></textarea>
      </div>

      <div class="modal-action mt-2">
        <button type="button" phx-click="close_query_form" class="btn btn-ghost btn-sm">
          Cancel
        </button>
        <button type="submit" class="btn btn-primary btn-sm">
          {if @editing_key, do: "Save Changes", else: "Create Query"}
        </button>
      </div>
    </form>
  </div>
  <div class="modal-backdrop" phx-click="close_query_form"></div>
</dialog>
