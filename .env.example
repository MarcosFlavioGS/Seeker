# Copy this file to .env and fill in your real credentials.
# The .env file is gitignored — never commit it.

# ── Just Travel — Production ──────────────────────────────────────────────────
JUST_TRAVEL_PROD_DB_HOST=justtravel-rds.justtraveltour.com
JUST_TRAVEL_PROD_DB_PORT=5432
JUST_TRAVEL_PROD_DB_USER=marcos.flavio
JUST_TRAVEL_PROD_DB_PASS=PROD_6Z9ODv4G
JUST_TRAVEL_PROD_DB_NAME=hermes

# ── Just Travel — Homologation ────────────────────────────────────────────────
JUST_TRAVEL_HOMO_DB_HOST=homo-db-host.example.com
JUST_TRAVEL_HOMO_DB_PORT=5432
JUST_TRAVEL_HOMO_DB_USER=your_username
JUST_TRAVEL_HOMO_DB_PASS=your_password
JUST_TRAVEL_HOMO_DB_NAME=homologation_db_name

# ── SSL ───────────────────────────────────────────────────────────────────────
# "verify_peer" (recommended) or "verify_none" (self-signed / no cert validation)
JUST_TRAVEL_DB_SSL_MODE=verify_peer

# Path to CA bundle — only used when SSL_MODE=verify_peer
JUST_TRAVEL_DB_SSL_CACERT=/etc/ssl/certs/ca-certificates.crt

# ── Add new organizations below ───────────────────────────────────────────────
# ACME_PROD_DB_HOST=...
# ACME_PROD_DB_PORT=5432
# ACME_PROD_DB_USER=...
# ACME_PROD_DB_PASS=...
# ACME_PROD_DB_NAME=...
