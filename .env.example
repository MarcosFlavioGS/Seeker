# Copy this file to .env and fill in your real credentials.
# The .env file is gitignored — never commit it.

# ── Acme Corp — Production ────────────────────────────────────────────────────
ACME_PROD_DB_HOST=db-host.example.com
ACME_PROD_DB_PORT=5432
ACME_PROD_DB_USER=your_username
ACME_PROD_DB_PASS=your_password
ACME_PROD_DB_NAME=db-name

# ── Acme Corp — Staging ───────────────────────────────────────────────────────
ACME_STAGING_DB_HOST=staging-db-host.example.com
ACME_STAGING_DB_PORT=5432
ACME_STAGING_DB_USER=your_username
ACME_STAGING_DB_PASS=your_password
ACME_STAGING_DB_NAME=staging_db_name

# ── SSL ───────────────────────────────────────────────────────────────────────
# "verify_peer" (recommended) or "verify_none" (self-signed / no cert validation)
ACME_DB_SSL_MODE=verify_peer

# Path to CA bundle — only used when SSL_MODE=verify_peer
ACME_DB_SSL_CACERT=/etc/ssl/certs/ca-certificates.crt

# ── Add new organizations below ───────────────────────────────────────────────
# WIDGETS_PROD_DB_HOST=...
# WIDGETS_PROD_DB_PORT=5432
# WIDGETS_PROD_DB_USER=...
# WIDGETS_PROD_DB_PASS=...
# WIDGETS_PROD_DB_NAME=...
